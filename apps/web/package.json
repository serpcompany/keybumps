{
  "name": "keybumps-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "biome format --write",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:leak": "node scripts/leak-test.mjs",
    "check": "pnpm check:code && opennextjs-cloudflare build",
    "check:code": "pnpm lint && pnpm typecheck && pnpm test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:staging": "SITE_ENV=staging opennextjs-cloudflare build",
    "build:production": "SITE_ENV=production opennextjs-cloudflare build",
    "deploy:staging": "pnpm build:staging && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "pnpm build:production && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@next/third-parties": "16.3.8",
    "@opennextjs/cloudflare": "1.20.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "path-to-regexp": "6.3.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vitest": "5.0.2",
    "wrangler": "4.143.1"
  }
}
